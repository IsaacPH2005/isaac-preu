# ─── IA (obligatorio para extraer preguntas) ─────────────────────────
# Obtén una clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claves extra separadas por comas (deben ser de PROYECTOS distintos; las de un mismo proyecto comparten cuota).
# Cuando una agota su cuota diaria se usa la siguiente.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash
# Páginas enviadas a Gemini en paralelo por documento (baja a 1-2 si ves errores 429)
GEMINI_CONCURRENCY=4
# Límite de solicitudes por minuto (plan gratuito de Gemini = 5; 0 = sin límite, para cuentas de pago)
GEMINI_RPM=5
# Razonamiento: GEMINI_THINKING_LEVEL para modelos 3.x (minimal|low|medium|high), GEMINI_THINKING_BUDGET solo para 2.5
GEMINI_THINKING_LEVEL=low
GEMINI_THINKING_BUDGET=0

# ─── Procesamiento ───────────────────────────────────────────────────
RENDER_DPI=150
MAX_UPLOAD_MB=300
# Documentos procesados simultáneamente por el worker
WORKER_CONCURRENCY=2

# ─── Base de datos ───────────────────────────────────────────────────
POSTGRES_USER=bancopreu
POSTGRES_PASSWORD=bancopreu
POSTGRES_DB=bancopreu

# ─── Red ─────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=8000
CORS_ORIGINS=*

# ─── Producción ──────────────────────────────────────────────────────
# false = solo búsqueda (sin subir, reprocesar ni eliminar documentos)
ALLOW_UPLOADS=true
# ─── OpenRouter (alternativa/complemento a Gemini) ─────────────────
OPENROUTER_API_KEY=
# Modelos en orden de preferencia (vacío = lista por defecto de modelos :free con visión)
OPENROUTER_MODELS=
# Plan gratuito: 20/min y 50/día (1000/día si cargas 10 USD de crédito una vez)
OPENROUTER_RPM=16
# Proveedores que se reparten las páginas
LLM_PROVIDERS=gemini,openrouter,nvidia

# ─── NVIDIA NIM (build.nvidia.com, API compatible con OpenAI) ─────────
NVIDIA_API_KEY=
# Vacío = nemotron-3.5-super-vl-120b-a12b, gemma-4-31b-it
NVIDIA_MODELS=
NVIDIA_RPM=30
