# ─── .env del VPS (producción) ───────────────────────────────────────
# Copia este archivo como .env en el servidor:  cp .env.production.example .env
#
# ⚠️  NO pongas aquí claves de IA (GEMINI / OPENROUTER / NVIDIA): producción no las usa
#     y docker-compose.prod.yml las vacía igualmente.

# Subdominio que apunta (registro DNS A) a la IP del VPS
DOMAIN=isaacpreu.pulsarsrl.cloud

# Contraseña de la base de datos: genera una larga, por ejemplo con
#   openssl rand -hex 24
POSTGRES_USER=bancopreu
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASEÑA
POSTGRES_DB=bancopreu

# Proxy: por defecto Caddy escucha SOLO en 127.0.0.1:8085 y el nginx del VPS lo publica
# con HTTPS (ver deploy/nginx/). Si el VPS NO tiene nginx, descomenta:
# CADDY_SITE_ADDRESS=isaacpreu.pulsarsrl.cloud
# CADDY_BIND=0.0.0.0
# HTTP_PORT=80
# HTTPS_PORT=443
